int32_t AudioCmdHashInit()
{
    int32_t arraySize = sizeof(g_AudioCmd) / sizeof(AudioCmdHandle_t);
    int32_t count = 0;

    if(NULL == g_hashTable)
    {
        g_hashTable = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);;
    }

    for(count = 0; count < arraySize; count++) 
    {
        char *key_copy = g_strdup(g_AudioCmd[count].cmdName);
        if (key_copy == NULL) 
        {
            LOG_Error("g_strdup failed");
            return RET_ERR;
        }
        g_strstrip(key_copy);
        g_hash_table_insert(g_hashTable, (gpointer)key_copy, GINT_TO_POINTER(count));
    }
}

int32_t AudioCmdHashDestroy()
{
    if(NULL != g_hashTable)
    {
        g_hash_table_destroy(g_hashTable);
    }
}

// 打印字符串的十六进制表示
void print_hex(const char *str, const char *label) {
    if (str == NULL) {
        LOG_Error("%s: (null)", label);
        return;
    }
    LOG_Error("%s: '%s' at %p, hex:", label, str, (void*)str);
    for (int i = 0; str[i] != '\0'; i++) {
        if (i % 16 == 0 && i > 0) LOG_Error(""); // 换行
        LOG_Error(" %02x", (unsigned char)str[i]);
    }
    LOG_Error(" 00\n"); // 显示终止符
}
void print_entry (gpointer key, gpointer value, gpointer user_data)
{
    // 假设 key 和 value 都是字符串
    const char *k = (const char *)key;
    // const char *v = (const char *)value;
    // const char *prefix = (const char *)user_data; // 可选的用户数据

    print_hex(k, "Stored Key");
}
void print_entry_with_comparison(gpointer key, gpointer value, gpointer user_data)
{
    const char *stored_key = (const char *)key;
    const char *lookup_key = (const char *)user_data;
    
    if (strncmp(stored_key, lookup_key, strlen(lookup_key)) == 0) {
        LOG_Error("发现部分匹配的键: '%s'", stored_key);
    }
    
    if (strcmp(stored_key, lookup_key) == 0) {
        LOG_Error("!!! 发现完全匹配的键但查找失败: '%s'", stored_key);
    }
}
int32_t GetCmdIndexFromHash(const char *cmdStr)
{
    int32_t arrayIndex = -1;
    gpointer result = NULL;
    GHashTable *hashTable = NULL;

    int32_t arraySize = sizeof(g_AudioCmd) / sizeof(AudioCmdHandle_t);
    int32_t count = 0;

    if(NULL == hashTable)
    {
        hashTable = g_hash_table_new_full(g_str_hash, g_str_equal, g_free, NULL);;
    }

    for(count = 0; count < arraySize; count++) 
    {
        char *key_copy = g_strdup(g_AudioCmd[count].cmdName);
        if (key_copy == NULL) 
        {
            LOG_Error("g_strdup failed");
            return RET_ERR;
        }
        g_strstrip(key_copy);
        g_hash_table_insert(hashTable, (gpointer)key_copy, GINT_TO_POINTER(count));
    }

    if(NULL == g_hashTable)
    {
        LOG_Error("g_hashTable is NULL");
        return RET_ERR;
    }
    print_hex(cmdStr, "Looking up: ");
    char *normalized_cmd = g_strdup(cmdStr);
    g_strstrip(normalized_cmd); // 去除前后空白
    result = g_hash_table_lookup(hashTable, normalized_cmd);
    if (result != NULL) 
    {
        arrayIndex = GPOINTER_TO_INT(result);
    } 
    else 
    {
        LOG_Error("未找到CMD: %s\n", cmdStr);
        g_hash_table_foreach (hashTable, print_entry_with_comparison, (gpointer)cmdStr);
    }
    g_free(normalized_cmd);
    return arrayIndex;
}

int32_t GetAudioCmdHandleFromArray(int32_t index, AudioCmdHandle_t *audioCmdHandle)
{
    if(NULL == audioCmdHandle)
    {
        LOG_Error("%s argv is NULL", __FUNCTION__);
        return RET_ERR;
    }

    if(index >= (sizeof(g_AudioCmd) / sizeof(AudioCmdHandle_t)) || index < 0)
    {
        LOG_Error("%s index error", __FUNCTION__);
        return RET_ERR;
    }

    audioCmdHandle->cmdName = g_AudioCmd[index].cmdName;
    audioCmdHandle->callBack = g_AudioCmd[index].callBack;

    return RET_OK;
}

